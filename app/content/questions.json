  { "id": "q-heart-004", "node_ids": ["heart"], "type": "single_choice", "stem": "心开窍于？", "options": ["目", "舌", "口", "鼻", "耳"], "answer": 1, "why": "心开窍于舌。舌为心之苗，心血上荣于舌则舌质红润。", "difficulty": 1, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-heart-005", "node_ids": ["heart"], "type": "single_choice", "stem": "心与哪个腑相表里？", "options": ["大肠", "小肠", "胆", "胃", "膀胱"], "answer": 1, "why": "心与小肠互为表里，心火可下移小肠致小便短赤。", "difficulty": 1, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-heart-006", "node_ids": ["heart"], "type": "single_choice", "stem": "下列哪项不是心的主要生理功能？", "options": ["主血脉", "主神志", "主运化", "其华在面", "开窍于舌"], "answer": 2, "why": "主运化是脾的功能，不是心。心的核心生理功能是主血脉、主神志。", "difficulty": 2, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-heart-007", "node_ids": ["heart"], "type": "single_choice", "stem": "「君主之官」指的是？", "options": ["肝", "心", "脾", "肺", "肾"], "answer": 1, "why": "《素问》称心为「君主之官」「五脏之首」，主宰生命活动。", "difficulty": 1, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-heart-008", "node_ids": ["heart"], "type": "fill_in_blank", "stem": "心的两大核心生理功能：主 ___ 和主 ___ 。", "answer": ["血脉、神志", "血脉,神志", "血脉神志"], "why": "心的核心生理功能：主血脉（推动血液周流）+ 主神志（主宰精神意识思维）。", "difficulty": 2, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },

  { "id": "q-spleen-001", "node_ids": ["spleen"], "type": "single_choice", "stem": "脾在五行属？", "options": ["木", "火", "土", "金", "水"], "answer": 2, "why": "脾在五行属土，居中央，主运化。", "difficulty": 1, "source": {"file":"中医.docx","line":595}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-002", "node_ids": ["spleen"], "type": "single_choice", "stem": "脾在志为？", "options": ["喜", "怒", "思", "悲", "恐"], "answer": 2, "why": "脾在志为思，思虑过度伤脾。", "difficulty": 1, "source": {"file":"中医.docx","line":595}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-003", "node_ids": ["spleen"], "type": "single_choice", "stem": "脾在液为？", "options": ["汗", "泪", "涕", "涎", "唾"], "answer": 3, "why": "脾在液为涎，涎为脾之液，由口溢出。", "difficulty": 1, "source": {"file":"中医.docx","line":595}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-004", "node_ids": ["spleen"], "type": "single_choice", "stem": "脾开窍于？", "options": ["目", "舌", "口", "鼻", "耳"], "answer": 2, "why": "脾开窍于口，其华在唇。脾气健运则口能知五味，唇红润。", "difficulty": 1, "source": {"file":"中医.docx","line":595}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-005", "node_ids": ["spleen"], "type": "single_choice", "stem": "「后天之本」指的是？", "options": ["心", "肝", "脾", "肺", "肾"], "answer": 2, "why": "脾胃为后天之本、气血生化之源。脾主运化水谷精微，化生气血。", "difficulty": 1, "source": {"file":"中医.docx","line":595}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-006", "node_ids": ["spleen"], "type": "multiple_choice", "stem": "脾的核心生理功能包括（多选）：", "options": ["主运化", "主升", "主统血", "主纳气", "主疏泄"], "answer": [0, 1, 2], "why": "脾的三大功能：主运化、主升（升清+升举内脏）、主统血。主纳气是肾，主疏泄是肝。", "difficulty": 2, "source": {"file":"中医.docx","line":595}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-007", "node_ids": ["spleen"], "type": "single_choice", "stem": "脾喜什么、恶什么？", "options": ["喜润恶燥", "喜燥恶湿", "喜温恶寒", "喜凉恶热", "喜动恶静"], "answer": 1, "why": "脾喜燥恶湿，湿邪最易困脾阳。", "difficulty": 2, "source": {"file":"中医.docx","line":790}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-008", "node_ids": ["spleen"], "type": "fill_in_blank", "stem": "脾为 ___ 之本，气血生化之源。", "answer": ["后天"], "why": "脾为后天之本，与肾（先天之本）相对应。", "difficulty": 1, "source": {"file":"中医.docx","line":595}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },

  { "id": "q-lung-001", "node_ids": ["lung"], "type": "single_choice", "stem": "肺在五行属？", "options": ["木", "火", "土", "金", "水"], "answer": 3, "why": "肺在五行属金，主肃降收敛。", "difficulty": 1, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-lung-002", "node_ids": ["lung"], "type": "single_choice", "stem": "肺在志为？", "options": ["喜", "怒", "思", "悲忧", "恐"], "answer": 3, "why": "肺在志为悲忧，过度悲忧伤肺。", "difficulty": 1, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-lung-003", "node_ids": ["lung"], "type": "single_choice", "stem": "肺开窍于？", "options": ["目", "舌", "口", "鼻", "耳"], "answer": 3, "why": "肺开窍于鼻。肺司呼吸，鼻为气体出入门户。", "difficulty": 1, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-lung-004", "node_ids": ["lung"], "type": "single_choice", "stem": "「华盖」「娇脏」分别指什么？", "options": ["心 / 肝", "肺 / 肺", "脾 / 肾", "肝 / 心", "肾 / 脾"], "answer": 1, "why": "肺位胸腔高位覆盖五脏六腑称「华盖」；肺叶娇嫩不耐寒热称「娇脏」。两者都指肺。", "difficulty": 2, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-lung-005", "node_ids": ["lung"], "type": "single_choice", "stem": "「水之上源」是？", "options": ["心", "肝", "脾", "肺", "肾"], "answer": 3, "why": "肺通调水道，称水之上源。肺主行水。", "difficulty": 2, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-lung-006", "node_ids": ["lung"], "type": "multiple_choice", "stem": "肺的主要生理功能包括（多选）：", "options": ["主气司呼吸", "主宣发", "主肃降", "通调水道", "藏精"], "answer": [0, 1, 2, 3], "why": "肺的主要功能：主气司呼吸、主宣发肃降、通调水道、朝百脉、主治节。藏精是肾。", "difficulty": 2, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-lung-007", "node_ids": ["lung"], "type": "single_choice", "stem": "肺与下列哪个腑相表里？", "options": ["小肠", "胆", "胃", "大肠", "膀胱"], "answer": 3, "why": "肺与大肠相表里。肺气肃降助大肠传导，便秘可由肺失肃降致。", "difficulty": 1, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-lung-008", "node_ids": ["lung"], "type": "fill_in_blank", "stem": "肺主气，包括主 ___ 之气和主 ___ 之气。", "answer": ["呼吸、一身", "一身、呼吸"], "why": "肺主气包括主呼吸之气（气体交换）和主一身之气（生成宗气 + 调节全身气机）。", "difficulty": 2, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },

  { "id": "q-kidney-001", "node_ids": ["kidney"], "type": "single_choice", "stem": "肾在五行属？", "options": ["木", "火", "土", "金", "水"], "answer": 4, "why": "肾在五行属水，主水液。", "difficulty": 1, "source": {"file":"中医.docx","line":599}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-002", "node_ids": ["kidney"], "type": "single_choice", "stem": "肾在志为？", "options": ["喜", "怒", "思", "悲", "恐"], "answer": 4, "why": "肾在志为恐，过度惊恐伤肾。", "difficulty": 1, "source": {"file":"中医.docx","line":599}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-003", "node_ids": ["kidney"], "type": "single_choice", "stem": "肾其华在？", "options": ["面", "唇", "爪", "毛", "发"], "answer": 4, "why": "肾其华在发，发为血之余，赖肾精滋养。肾精充足则发茂润。", "difficulty": 1, "source": {"file":"中医.docx","line":599}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-004", "node_ids": ["kidney"], "type": "single_choice", "stem": "肾开窍于？", "options": ["舌", "目", "口", "鼻", "耳及二阴"], "answer": 4, "why": "肾开窍于耳及二阴。肾精充足则听觉灵敏、二便正常。", "difficulty": 1, "source": {"file":"中医.docx","line":599}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-005", "node_ids": ["kidney"], "type": "single_choice", "stem": "「先天之本」指的是？", "options": ["心", "肝", "脾", "肺", "肾"], "answer": 4, "why": "肾藏先天之精，故称先天之本。与脾（后天之本）相对应。", "difficulty": 1, "source": {"file":"中医.docx","line":599}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-006", "node_ids": ["kidney"], "type": "multiple_choice", "stem": "肾的核心生理功能包括（多选）：", "options": ["藏精", "主水", "主纳气", "主疏泄", "主运化"], "answer": [0, 1, 2], "why": "肾的三大核心功能：藏精、主水、主纳气。主疏泄是肝，主运化是脾。", "difficulty": 2, "source": {"file":"中医.docx","line":599}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-007", "node_ids": ["kidney"], "type": "single_choice", "stem": "「水火之宅」指哪个脏？", "options": ["心", "肝", "脾", "肺", "肾"], "answer": 4, "why": "肾内寓元阴元阳，称水火之宅、阴阳之本。", "difficulty": 2, "source": {"file":"中医.docx","line":587}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-008", "node_ids": ["kidney"], "type": "fill_in_blank", "stem": "「___ 者，肾之府」（《素问·脉要精微论》）。", "answer": ["腰"], "why": "腰为肾之府。腰痛常责之于肾。", "difficulty": 2, "source": {"file":"中医.docx","line":599}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-009", "node_ids": ["kidney"], "type": "single_choice", "stem": "呼多吸少、动则气短最可能是哪个脏的问题？", "options": ["肺失主气", "肾失纳气", "心不主血", "肝失疏泄", "脾失健运"], "answer": 1, "why": "肺为气之主，肾为气之根。呼多吸少、动则气短是肾不纳气的典型表现。", "difficulty": 2, "source": {"file":"中医.docx","line":829}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },

  { "id": "q-cold-001", "node_ids": ["cold-evil"], "type": "single_choice", "stem": "下列哪项不是寒邪的性质？", "options": ["阴邪", "易伤阳气", "凝滞", "收引", "升散"], "answer": 4, "why": "升散是暑邪的性质，不是寒。寒邪性凝滞、收引、清澈，易伤阳气。", "difficulty": 2, "source": {"file":"中医.docx","line":1429}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cold-002", "node_ids": ["cold-evil"], "type": "single_choice", "stem": "「寒主疼痛」体现的是寒邪的哪个性质？", "options": ["阴邪", "凝滞", "收引", "清澈", "升散"], "answer": 1, "why": "寒性凝滞致气血凝滞、运行不畅，故主疼痛。", "difficulty": 2, "source": {"file":"中医.docx","line":1431}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cold-003", "node_ids": ["cold-evil"], "type": "single_choice", "stem": "寒邪「主收引」最典型的表现是？", "options": ["剧烈疼痛", "关节屈伸不利、拘急", "出血", "皮肤干燥", "高热"], "answer": 1, "why": "寒主收引致筋脉拘急、关节屈伸不利，伴拘挛作痛。", "difficulty": 2, "source": {"file":"中医.docx","line":1432}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cold-004", "node_ids": ["cold-evil"], "type": "single_choice", "stem": "「清澈」指寒邪致病的分泌物有什么特点？", "options": ["黄稠", "清稀", "黏滞", "腥臭", "脓血"], "answer": 1, "why": "寒性清澈致分泌物或排泄物呈清稀状（白色、无臭、量多）。", "difficulty": 2, "source": {"file":"中医.docx","line":1432}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cold-005", "node_ids": ["cold-evil"], "type": "multiple_choice", "stem": "寒邪的核心性质包括（多选）：", "options": ["阴邪伤阳", "凝滞", "收引", "清澈", "重浊黏滞"], "answer": [0, 1, 2, 3], "why": "重浊黏滞是湿邪的性质。寒邪 4 大性质：阴邪伤阳、凝滞、收引、清澈。", "difficulty": 2, "source": {"file":"中医.docx","line":1429}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },

  { "id": "q-damp-001", "node_ids": ["damp-evil"], "type": "single_choice", "stem": "湿邪致病最具特征性的症状是？", "options": ["剧痛", "高热", "重痛", "刺痛", "灼痛"], "answer": 2, "why": "湿性重浊，致病多见沉重、重着的「重痛」。", "difficulty": 2, "source": {"file":"中医.docx","line":1296}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-damp-002", "node_ids": ["damp-evil"], "type": "single_choice", "stem": "湿邪最易困伤哪个脏？", "options": ["心", "肝", "脾", "肺", "肾"], "answer": 2, "why": "脾喜燥恶湿，湿邪最先困脾阳，影响脾运化。", "difficulty": 2, "source": {"file":"中医.docx","line":1295}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-damp-003", "node_ids": ["damp-evil"], "type": "single_choice", "stem": "湿邪致病具有「病程缠绵」的特点，这体现的是哪个性质？", "options": ["重浊", "黏滞", "趋下", "阴邪", "升散"], "answer": 1, "why": "湿性黏滞致症状黏滞、病程缠绵——反复发作、时起时伏、难愈。", "difficulty": 2, "source": {"file":"中医.docx","line":1299}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-damp-004", "node_ids": ["damp-evil"], "type": "single_choice", "stem": "湿邪「趋下」最常见的表现是？", "options": ["头痛", "胸闷", "下肢水肿", "面部红肿", "颈项强直"], "answer": 2, "why": "湿性类水趋下，致病多伤下部。下肢水肿、淋病、带下、尿浊都是典型。", "difficulty": 2, "source": {"file":"中医.docx","line":1301}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-damp-005", "node_ids": ["damp-evil"], "type": "multiple_choice", "stem": "湿邪的核心性质包括（多选）：", "options": ["阻气机损阳气", "重浊", "黏滞", "趋下", "炎上"], "answer": [0, 1, 2, 3], "why": "湿邪 4 大性质：阻气机损阳气、重浊、黏滞、趋下。炎上是火邪。", "difficulty": 2, "source": {"file":"中医.docx","line":1293}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },

  { "id": "q-fire-001", "node_ids": ["fire-evil"], "type": "single_choice", "stem": "六淫中最易导致出血的是？", "options": ["风", "寒", "湿", "燥", "火"], "answer": 4, "why": "火热邪能动血——迫血妄行致各种出血证（吐血、衄血、崩漏等）。", "difficulty": 1, "source": {"file":"中医.docx","line":431}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-fire-002", "node_ids": ["fire-evil"], "type": "single_choice", "stem": "火邪「炎上」致病多见于人体哪个部位？", "options": ["上部", "中部", "下部", "全身均匀", "深部脏腑"], "answer": 0, "why": "火性炎上，症状多见于人体上部：头痛、面赤、咽喉肿痛、口舌生疮等。", "difficulty": 2, "source": {"file":"中医.docx","line":1442}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-fire-003", "node_ids": ["fire-evil"], "type": "single_choice", "stem": "下列哪项不是火邪的致病特点？", "options": ["扰心神", "耗气伤津", "生风动血", "致肿疡", "粘滞缠绵"], "answer": 4, "why": "粘滞缠绵是湿邪的特点。火邪的特点：阳邪炎上、扰心神、耗气伤津、生风动血、致肿疡。", "difficulty": 2, "source": {"file":"中医.docx","line":1442}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-fire-004", "node_ids": ["fire-evil"], "type": "single_choice", "stem": "火邪「生风」表现为？", "options": ["眩晕", "高热神昏、四肢抽搐", "皮肤瘙痒", "鼻塞流涕", "关节疼痛"], "answer": 1, "why": "火热生风（肝风内动）→ 高热神昏、四肢抽搐、颈项强直、角弓反张、两目上视。", "difficulty": 2, "source": {"file":"中医.docx","line":1443}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-fire-005", "node_ids": ["fire-evil"], "type": "multiple_choice", "stem": "火邪的致病特点包括（多选）：", "options": ["炎上", "扰心神", "耗气伤津", "生风动血", "凝滞收引"], "answer": [0, 1, 2, 3], "why": "凝滞收引是寒邪。火邪 5 大特点：炎上、扰心神、耗气伤津、生风动血、致肿疡。", "difficulty": 2, "source": {"file":"中医.docx","line":1442}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },

  { "id": "q-zang-001", "node_ids": ["heart","liver","spleen","lung","kidney"], "type": "match", "stem": "五脏与在液的对应（连线）：", "options": { "left": ["心", "肝", "脾", "肺", "肾"], "right": ["泪", "汗", "唾", "涕", "涎"] }, "answer": [[0,1],[1,0],[2,4],[3,3],[4,2]], "why": "五脏在液：心-汗、肝-泪、脾-涎、肺-涕、肾-唾。", "difficulty": 2, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-zang-002", "node_ids": ["heart","liver","spleen","lung","kidney"], "type": "match", "stem": "五脏与开窍部位的对应（连线）：", "options": { "left": ["心", "肝", "脾", "肺", "肾"], "right": ["目", "口", "舌", "耳及二阴", "鼻"] }, "answer": [[0,2],[1,0],[2,1],[3,4],[4,3]], "why": "五脏开窍：心-舌、肝-目、脾-口、肺-鼻、肾-耳及二阴。", "difficulty": 2, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-zang-003", "node_ids": ["heart","liver","spleen","lung","kidney"], "type": "match", "stem": "五脏与在志情绪的对应（连线）：", "options": { "left": ["心", "肝", "脾", "肺", "肾"], "right": ["怒", "悲忧", "思", "恐", "喜"] }, "answer": [[0,4],[1,0],[2,2],[3,1],[4,3]], "why": "五脏在志：心-喜、肝-怒、脾-思、肺-悲忧、肾-恐。", "difficulty": 2, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-zang-004", "node_ids": ["heart","liver","spleen","lung","kidney"], "type": "sort", "stem": "按五行相生顺序排列（木 → 火 → 土 → 金 → 水）：", "options": ["心", "脾", "肝", "肾", "肺"], "answer": [2, 0, 1, 4, 3], "why": "五行相生：木火土金水 → 肝心脾肺肾。", "difficulty": 2, "source": {"file":"中医.docx","line":288}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-zang-005", "node_ids": ["heart","kidney"], "type": "single_choice", "stem": "「水火既济」「心肾相交」体现的是？", "options": ["相生关系", "相克关系", "母子关系", "阴阳水火互济关系", "表里关系"], "answer": 3, "why": "心火下温肾水、肾水上济心火，称水火既济或心肾相交，是阴阳互资互济的典型。", "difficulty": 2, "source": {"file":"中医.docx","line":234}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cross-002", "node_ids": ["lung","spleen"], "type": "single_choice", "stem": "「培土生金」体现的是？", "options": ["金生水", "土生金", "木克土", "水克火", "火生土"], "answer": 1, "why": "培土生金 = 通过补脾（土）来益肺（金），五行属土生金。脾肺气虚常合并治疗。", "difficulty": 2, "source": {"file":"中医.docx","line":857}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cross-003", "node_ids": ["fire-evil","liver"], "type": "single_choice", "stem": "高热神昏伴四肢抽搐、角弓反张，最可能是？", "options": ["心血虚", "肝风内动", "脾不统血", "肺燥伤津", "肾精不足"], "answer": 1, "why": "火热邪能生风，热极生风致肝风内动 → 抽搐、强直、角弓反张。", "difficulty": 3, "source": {"file":"中医.docx","line":1443}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },

  { "id": "q-heart-009", "node_ids": ["heart"], "type": "single_choice", "stem": "「神之舍」「血之主」「脉之宗」指的是？", "options": ["肝", "心", "脾", "肺", "肾"], "answer": 1, "why": "心为神之舍、血之主、脉之宗，是五脏之首。", "difficulty": 2, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-heart-010", "node_ids": ["heart"], "type": "single_choice", "stem": "「心藏神」中的「神」主要指？", "options": ["心情愉悦", "精神意识思维活动", "血液循环", "体表光泽", "营养代谢"], "answer": 1, "why": "「神」指精神、意识、思维等心理活动。心主神志即主宰这些活动。", "difficulty": 2, "source": {"file":"中医.docx","line":1540}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-009", "node_ids": ["spleen"], "type": "single_choice", "stem": "脾不统血的临床表现包括？", "options": ["剧烈头痛", "皮下出血、月经过多", "高热", "腹胀痛", "眩晕"], "answer": 1, "why": "脾不统血致各种出血：皮下出血、月经过多、便血、尿血、肌衄、齿衄、崩漏等。", "difficulty": 2, "source": {"file":"中医.docx","line":1582}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-spleen-010", "node_ids": ["spleen"], "type": "single_choice", "stem": "脾主升清失常会导致？", "options": ["关节疼痛", "头晕目眩、腹胀便溏", "皮肤干燥", "鼻塞流涕", "心烦失眠"], "answer": 1, "why": "脾气不升清 → 神疲乏力、头晕目眩、腹胀便溏、泄泻等。", "difficulty": 2, "source": {"file":"中医.docx","line":326}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-lung-009", "node_ids": ["lung"], "type": "single_choice", "stem": "「朝百脉」是哪个脏的功能？", "options": ["心", "肝", "脾", "肺", "肾"], "answer": 3, "why": "全身血液通过百脉会聚于肺，进行气体交换，称肺朝百脉。", "difficulty": 2, "source": {"file":"中医.docx","line":593}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-010", "node_ids": ["kidney"], "type": "single_choice", "stem": "天癸由什么化生？", "options": ["心血", "肝精", "脾气", "肺津", "肾精"], "answer": 4, "why": "肾中精气充盈到一定程度产生具有促进生殖功能成熟的物质——天癸。", "difficulty": 2, "source": {"file":"中医.docx","line":1476}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-kidney-011", "node_ids": ["kidney","fu-zi"], "type": "single_choice", "stem": "命门火衰首选药物是？", "options": ["黄芪", "人参", "干姜", "附子", "麻黄"], "answer": 3, "why": "附子补火助阳，专治命门火衰、肾阳不足。", "difficulty": 2, "source": {"file":"中医.docx","line":13}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cross-004", "node_ids": ["spleen","lung"], "type": "fill_in_blank", "stem": "「___ 为水之上源」「水之下源」分别是肺和肾，中游是脾。", "answer": ["肺"], "why": "肺为水之上源（宣发肃降通调水道）；肾为水之下源（主水）；脾运化水液在中游。", "difficulty": 3, "source": {"file":"中医.docx","line":236}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cross-005", "node_ids": ["heart","spleen"], "type": "single_choice", "stem": "「心脾两虚」的典型临床表现？", "options": ["心悸失眠 + 腹胀便溏", "高热抽搐", "腰痛遗精", "咳喘痰多", "胸胁胀痛"], "answer": 0, "why": "心脾两虚：心悸健忘失眠多梦 + 饮食减少腹胀便溏 + 倦怠乏力 + 面色萎黄。", "difficulty": 2, "source": {"file":"中医.docx","line":1402}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cross-006", "node_ids": ["wind-evil","cold-evil"], "type": "single_choice", "stem": "风寒感冒的典型症状不包括？", "options": ["恶寒", "无汗", "头身痛", "鼻塞流清涕", "口苦咽干"], "answer": 4, "why": "口苦咽干是少阳/里热表现。风寒感冒：恶寒重发热轻、无汗、头身痛、鼻塞流清涕、苔薄白脉浮紧。", "difficulty": 2, "source": {"file":"中医.docx","line":1426}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-cross-007", "node_ids": ["damp-evil","spleen"], "type": "single_choice", "stem": "脾被湿邪所困的典型表现？", "options": ["头痛发热", "脘痞腹胀、便溏、四肢困重", "心烦失眠", "咳嗽气喘", "腰膝酸软"], "answer": 1, "why": "脾喜燥恶湿，湿困脾阳致脘痞腹胀、便溏、四肢困重、苔白腻。", "difficulty": 2, "source": {"file":"中医.docx","line":1295}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-six-evils-001", "node_ids": ["wind-evil","cold-evil","damp-evil","fire-evil"], "type": "match", "stem": "六淫与其代表性致病特点的对应（连线）：", "options": { "left": ["风", "寒", "湿", "火"], "right": ["阴邪伤阳气", "阳邪炎上动血", "百病之长", "重浊黏滞趋下"] }, "answer": [[0,2],[1,0],[2,3],[3,1]], "why": "风为百病之长；寒为阴邪易伤阳；湿重浊黏滞趋下；火为阳邪炎上动血。", "difficulty": 3, "source": {"file":"中医.docx","line":212}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-fuzi-009", "node_ids": ["fu-zi","kidney","heart","spleen"], "type": "multiple_choice", "stem": "附子归哪些经？（多选）", "options": ["心", "肝", "脾", "肺", "肾"], "answer": [0, 2, 4], "why": "附子归心、肾、脾三经——分别对应回阳救逆（心）、补火助阳（肾）、温脾阳（脾）。", "difficulty": 2, "source": {"file":"中医.docx","line":105}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-zang-006", "node_ids": ["heart","liver","spleen","lung","kidney"], "type": "match", "stem": "五脏与其华的对应（连线）：", "options": { "left": ["心", "肝", "脾", "肺", "肾"], "right": ["唇", "毛", "面", "发", "爪"] }, "answer": [[0,2],[1,4],[2,0],[3,1],[4,3]], "why": "五脏其华：心-面、肝-爪、脾-唇、肺-毛、肾-发。", "difficulty": 2, "source": {"file":"中医.docx","line":591}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" },
  { "id": "q-zang-007", "node_ids": ["heart","liver","spleen","lung","kidney"], "type": "sort", "stem": "按五行相克顺序排列（金 → 木 → 土 → 水 → 火）：", "options": ["心", "脾", "肝", "肾", "肺"], "answer": [4, 2, 1, 3, 0], "why": "五行相克：金木土水火 → 肺肝脾肾心。", "difficulty": 3, "source": {"file":"中医.docx","line":288}, "status": "reviewed", "created": "2026-05-23", "updated": "2026-05-23" }
]
